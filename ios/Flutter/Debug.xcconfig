#include "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Workaround für einen lipo-Regressionsbug in Xcode 27 Beta, der
// "-verify_arch" mit mehreren Architekturen fehlschlagen lässt.
// Auf Apple-Silicon-Macs wird die x86_64-Simulator-Slice ohnehin nicht gebraucht.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
ARCHS[sdk=iphonesimulator*] = arm64

