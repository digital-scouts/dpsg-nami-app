# Nach /opt/nami-statistics/.env kopieren (chmod 600) und alle Platzhalter ersetzen.
# Secrets erzeugen mit: openssl rand -hex 32

# Wird vom Deploy-Workflow pro Lauf gesetzt (sapza/nami-statistics:<git-sha>).
SERVER_IMAGE=sapza/nami-statistics:latest

# Externes Docker-Netz, in dem Caddy des DPSG-News-Stacks laeuft.
CADDY_NETWORK=dpsg-news_default

# MongoDB-Root-Zugang (nur im internen Docker-Netz erreichbar)
MONGO_ROOT_USERNAME=nami
MONGO_ROOT_PASSWORD=please_change_me

# Laufzeit des Statistikservers
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://nami:please_change_me@mongodb:27017/?authSource=admin
MONGODB_DATABASE=nami_statistics

# Muessen dauerhaft stabil bleiben (siehe server/deploy/README.md, Abschnitt Secrets).
PSEUDONYMIZATION_SECRET=please_change_me
SENDER_SECRET_PEPPER=please_change_me

# Hinter Caddy genau ein Proxy-Hop
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_INGEST_MAX=30
RATE_LIMIT_READ_MAX=120
MIN_STAMM_COUNT_FOR_READ=5
# mongodb fuer echten Betrieb; memory nur fuer die Mock-Instanz (Daten gehen beim Neustart verloren).
STORAGE_BACKEND=mongodb
# Anzahl synthetischer Staemme, nur mit STORAGE_BACKEND=memory erlaubt.
MOCK_SEED_STAMM_COUNT=0
# Monatsreport per Mail (spec/monatsreport.md). Ohne REPORT_SMTP_HOST ist er aus.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=
REPORT_SMTP_PASS=
REPORT_MAIL_FROM=
# Mehrere Empfaenger durch Komma getrennt.
REPORT_MAIL_TO=
