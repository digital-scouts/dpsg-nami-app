# Nach /opt/nami-statistics/mock.env kopieren (chmod 600) und die Secrets ersetzen.
# Eigene Secrets erzeugen mit: openssl rand -hex 32 (niemals die Werte aus .env wiederverwenden).

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Keine MongoDB: Daten liegen nur im Speicher, ein Neustart setzt die Instanz zurueck.
STORAGE_BACKEND=memory
# Synthetische Staemme, damit eine einzelne Test-Installation Bundeswerte erhaelt.
MOCK_SEED_STAMM_COUNT=30

PSEUDONYMIZATION_SECRET=please_change_me
SENDER_SECRET_PEPPER=please_change_me

# Hinter Caddy genau ein Proxy-Hop
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_INGEST_MAX=300
RATE_LIMIT_READ_MAX=600
MIN_STAMM_COUNT_FOR_READ=5
