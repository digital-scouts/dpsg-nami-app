NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Muss stabil bleiben, sonst aendern sich alle Stamm- und Sender-Pseudonyme.
PSEUDONYMIZATION_SECRET=replace-with-a-stable-secret
# Pepper fuer die Hashes der Installations-Secrets; ein Wechsel macht alle Installationen ungueltig.
SENDER_SECRET_PEPPER=replace-with-a-stable-pepper
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nami_statistics_local
# Anzahl vertrauenswuerdiger Reverse-Proxy-Hops (hinter Caddy: 1).
TRUST_PROXY_HOPS=0
BODY_LIMIT_BYTES=32768
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_INGEST_MAX=30
RATE_LIMIT_READ_MAX=120
# Mindestanzahl teilnehmender Staemme, ab der Bundeswerte ausgeliefert werden.
MIN_STAMM_COUNT_FOR_READ=5
# mongodb fuer echten Betrieb; memory nur fuer die Mock-Instanz (Daten gehen beim Neustart verloren).
STORAGE_BACKEND=mongodb
# Anzahl synthetischer Staemme, nur mit STORAGE_BACKEND=memory erlaubt.
MOCK_SEED_STAMM_COUNT=0
# Monatsreport per Mail (spec/monatsreport.md). Ohne REPORT_SMTP_HOST ist er aus.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=
REPORT_SMTP_PASS=
REPORT_MAIL_FROM=
# Mehrere Empfaenger durch Komma getrennt.
REPORT_MAIL_TO=
