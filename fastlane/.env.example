# Zugangsdaten fuer die Store-Lanes. Als fastlane/.env kopieren und die
# Pfade auf lokale Dateien ausserhalb des Repos setzen (nicht einchecken).

# App Store Connect API-Key als JSON (key_id, issuer_id, key), siehe
# https://docs.fastlane.tools/app-store-connect-api/#using-fastlane-api-key-json-file
APP_STORE_CONNECT_API_KEY_PATH=

# Google-Play-Dienstkonto als JSON (wie das GitHub-Secret ANDROID_SERVICE_ACCOUNT_JSON).
SUPPLY_JSON_KEY=
